<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/announcements.css">

<div class="ann-form-page">

    <a href="/announcements" class="ann-back">
        <i class="fa-solid fa-arrow-left"></i> Back to announcements
    </a>

    <div class="ann-form-heading">
        <span class="ann-eyebrow">CAMPUS CENTRAL</span>
        <h1>Create Announcement</h1>
        <p>Share important information with your campus community.</p>
    </div>


    <form
        action="/announcements"
        method="POST"
        enctype="multipart/form-data"
        class="ann-form"
    >

        <div class="ann-form-group">
            <label>Announcement Title *</label>

            <input
                type="text"
                name="announcement[title]"
                placeholder="Give your announcement a title"
                maxlength="150"
                required
            >
        </div>


        <div class="ann-form-group">
            <label>Description *</label>

            <textarea
                name="announcement[description]"
                rows="7"
                maxlength="5000"
                placeholder="Write the details here..."
                required
            ></textarea>

            <small>Maximum 5000 characters.</small>
        </div>


        <div class="ann-form-grid">

            <div class="ann-form-group">
                <label>Category *</label>

                <select name="announcement[category]" required>
                    <option value="General">General</option>
                    <option value="Academic">Academic</option>
                    <option value="Events">Events</option>
                    <option value="Clubs">Clubs</option>
                    <option value="Hostel">Hostel</option>
                    <option value="Placement">Placement</option>
                    <option value="Examinations">Examinations</option>
                </select>
            </div>


            <div class="ann-form-group">
                <label>Priority *</label>

                <select name="announcement[priority]" required>
                    <option value="Normal">Normal</option>
                    <option value="Important">Important</option>
                    <option value="Urgent">Urgent</option>
                </select>
            </div>

        </div>


        <% if (allowedScopes.length > 1) { %>

            <div class="ann-form-group">
                <label>Publish To *</label>

                <select name="announcement[scope]" id="announcementScope" required>

                    <option value="">Choose publishing scope</option>

                    <% allowedScopes.forEach(s => { %>
                        <option value="<%= s.scope %>">
                            <%= s.scope === "Class"
                                ? "My Class (" + s.branch + " · Year " + s.year + " · " + s.section + ")"
                                : s.scope === "Club"
                                ? s.club
                                : "College" %>
                        </option>
                    <% }) %>

                </select>
            </div>

        <% } else { %>

            <input
                type="hidden"
                name="announcement[scope]"
                value="<%= allowedScopes[0].scope %>"
            >

            <% if (allowedScopes[0].scope === "Class") { %>
                <div class="ann-scope-info">
                    <i class="fa-solid fa-users"></i>
                    Publishing to your class:
                    <strong>
                        <%= allowedScopes[0].branch %> · Year <%= allowedScopes[0].year %> · <%= allowedScopes[0].section %>
                    </strong>
                </div>
            <% } else if (allowedScopes[0].scope === "Club") { %>
                <div class="ann-scope-info">
                    <i class="fa-solid fa-people-group"></i>
                    Publishing to:
                    <strong><%= allowedScopes[0].club %></strong>
                </div>
            <% } else { %>
                <div class="ann-scope-info">
                    <i class="fa-solid fa-building-columns"></i>
                    Publishing to the entire college.
                </div>
            <% } %>

        <% } %>


        <div class="ann-form-group">
            <label>Attachment</label>

            <label for="announcementAttachment" class="ann-upload-box">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <strong>Upload an image</strong>
                <span>JPG, PNG or WEBP · Maximum 10 MB</span>
                <input
                    type="file"
                    id="announcementAttachment"
                    name="attachment"
                    accept="image/png,image/jpeg,image/webp"
                >
            </label>

            <div id="imagePreview" class="ann-image-preview"></div>
        </div>


        <div class="ann-form-actions">
            <a href="/announcements" class="ann-btn ann-btn-light">
                Cancel
            </a>

            <button type="submit" class="ann-btn ann-btn-primary">
                <i class="fa-solid fa-paper-plane"></i>
                Publish Announcement
            </button>
        </div>

    </form>

</div>


<script src="/js/announcements.js"></script>