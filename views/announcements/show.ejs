<% layout("/layouts/boilerplate") -%>
<%
    const targetTypes = announcement.targetTypes || [];
    const staffAudiences = Array.isArray(announcement.staffAudience) ? announcement.staffAudience : announcement.staffAudience ? [announcement.staffAudience] : [];
    const branches = announcement.branches || [];
    const years = announcement.years || [];
    const sections = announcement.sections || [];
    const audienceLabels = [];

    if (targetTypes.includes("Everyone")) {
        audienceLabels.push("Everyone");
    } else {
        if (targetTypes.includes("Student")) {
            const branchLabel = branches.length ? branches.join(", ") : "All Branches";
            const yearLabel = years.length ? years.map(year => `${year}${year === 1 ? "st" : year === 2 ? "nd" : year === 3 ? "rd" : "th"} Year`).join(", ") : "All Years";
            const sectionLabel = sections.length ? sections.map(section => `Section ${section}`).join(", ") : "All Sections";
            audienceLabels.push(`Students: ${branchLabel} | ${yearLabel} | ${sectionLabel}`);
        }

        if (targetTypes.includes("Staff")) {
            const staffLabel = staffAudiences.includes("All") || !staffAudiences.length ? "All Staff" : staffAudiences.join(", ");
            audienceLabels.push(`Staff: ${staffLabel}`);
        }
    }
%>
<div class="announcement-form-page">
    <div class="announcement-form-card">
        <div class="announcement-form-header">
            <div class="announcement-icon">
                <i class="fa-solid fa-bullhorn"></i>
            </div>
            <h1><%= announcement.title %></h1>
            <p>CampusAwaaz Announcement</p>
        </div>
        <div class="announcement-details">
            <div class="announcement-meta">
                <span class="announcement-category-badge">
                    <i class="fa-solid fa-tag me-2"></i><%= announcement.category %>
                </span>
                <span class="announcement-date">
                    <i class="fa-regular fa-calendar me-2"></i><%= new Date(announcement.createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                </span>
                <% if (announcement.isPinned) { %>
                    <span class="announcement-category-badge">
                        <i class="fa-solid fa-thumbtack me-2"></i>Pinned
                    </span>
                <% } %>
            </div>
            <div class="announcement-author">
                <div class="announcement-author-icon">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div>
                    <p class="announcement-author-name"><%= announcement.postedBy ? announcement.postedBy.name : "Unknown Author" %></p>
                    <p class="announcement-author-role"><%= announcement.postedBy ? (announcement.postedBy.accountType === "Staff" ? (announcement.postedBy.designation || "Staff") : (announcement.postedBy.studentRole || "Student")) : "CampusAwaaz Member" %></p>
                </div>
            </div>
            <hr>
            <div class="announcement-show-content"><%= announcement.description %></div>
            <div class="announcement-meta mt-3">
                <span class="announcement-category-badge">
                    <i class="fa-solid fa-users me-2"></i>
                    <%= audienceLabels.join(" • ") || "Audience not specified" %>
                </span>
                <span class="announcement-category-badge">
                    <i class="fa-solid fa-flag me-2"></i><%= announcement.priority %>
                </span>
            </div>
        </div>
        <% if (currUser && announcement.postedBy && announcement.postedBy._id.toString() === currUser._id.toString()) { %>
            <div class="announcement-form-actions announcement-show-actions">
                <a href="/announcements" class="btn btn-light">Back</a>
                <a href="/announcements/<%= announcement._id %>/edit" class="btn btn-announcement-submit">
                    <i class="fa-solid fa-pen-to-square me-2"></i>Edit
                </a>
                <form action="/announcements/<%= announcement._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this announcement?')">
                    <button type="submit" class="btn btn-announcement-delete">
                        <i class="fa-solid fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        <% } else { %>
            <div class="announcement-form-actions announcement-show-actions">
                <a href="/announcements" class="btn btn-light">Back to Announcements</a>
            </div>
        <% } %>
    </div>
</div>