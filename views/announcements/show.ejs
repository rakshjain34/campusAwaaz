<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/announcements.css">

<div class="ann-show-page">

    <a href="/announcements" class="ann-back">
        <i class="fa-solid fa-arrow-left"></i> All announcements
    </a>


    <article class="ann-show-card">

        <div class="ann-show-top">

            <span class="ann-category">
                <%= announcement.category %>
            </span>

            <span class="ann-priority <%= announcement.priority.toLowerCase() %>">
                <%= announcement.priority %>
            </span>

        </div>


        <% if (announcement.isPinned) { %>
            <div class="ann-pinned">
                <i class="fa-solid fa-thumbtack"></i> PINNED ANNOUNCEMENT
            </div>
        <% } %>


        <h1><%= announcement.title %></h1>


        <div class="ann-show-meta">

            <span>
                <i class="fa-solid fa-user"></i>
                <%= announcement.postedBy?.name || "Unknown" %>
            </span>

            <span>
                <i class="fa-regular fa-calendar"></i>
                <%= new Date(announcement.createdAt).toLocaleDateString("en-IN", {
                    day: "numeric",
                    month: "long",
                    year: "numeric"
                }) %>
            </span>

            <span>
                <i class="fa-solid fa-users"></i>

                <%= announcement.scope === "College"
                    ? "Entire College"
                    : announcement.scope === "Class"
                    ? announcement.branch + " · Year " + announcement.year + " · " + announcement.section
                    : announcement.club %>
            </span>

        </div>


        <hr>


        <div class="ann-show-description">
            <%= announcement.description %>
        </div>


        <% if (announcement.attachment) { %>

            <div class="ann-show-attachment">

                <% if (announcement.attachmentType === "image") { %>

                    <a href="<%= announcement.attachment %>" target="_blank">
                        <img src="<%= announcement.attachment %>" alt="Announcement attachment">
                    </a>

                <% } else { %>

                    <a href="<%= announcement.attachment %>" target="_blank" class="ann-btn ann-btn-light">
                        <i class="fa-solid fa-file-pdf"></i> View Attachment
                    </a>

                <% } %>

            </div>

        <% } %>


        <% if (currUser && announcement.postedBy &&
            announcement.postedBy._id.toString() === currUser._id.toString()) { %>

            <div class="ann-show-actions">

                <a href="/announcements/<%= announcement._id %>/edit" class="ann-btn ann-btn-primary">
                    <i class="fa-solid fa-pen"></i> Edit
                </a>

                <form
                    action="/announcements/<%= announcement._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this announcement?')"
                >
                    <button type="submit" class="ann-btn ann-btn-danger">
                        <i class="fa-solid fa-trash"></i> Delete
                    </button>
                </form>

            </div>

        <% } %>

    </article>

</div>