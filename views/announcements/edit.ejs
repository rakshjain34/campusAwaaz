<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/announcements.css">

<div class="ann-form-page">

    <a href="/announcements/<%= announcement._id %>" class="ann-back">
        <i class="fa-solid fa-arrow-left"></i> Back to announcement
    </a>

    <div class="ann-form-heading">
        <span class="ann-eyebrow">CAMPUS CENTRAL</span>
        <h1>Edit Announcement</h1>
        <p>Update your announcement details.</p>
    </div>


    <form
        action="/announcements/<%= announcement._id %>?_method=PUT"
        method="POST"
        enctype="multipart/form-data"
        class="ann-form"
    >

        <div class="ann-form-group">
            <label>Announcement Title *</label>

            <input
                type="text"
                name="announcement[title]"
                value="<%= announcement.title %>"
                maxlength="150"
                required
            >
        </div>


        <div class="ann-form-group">
            <label>Description *</label>

            <textarea
                name="announcement[description]"
                rows="7"
                maxlength="5000"
                required
            ><%= announcement.description %></textarea>
        </div>


        <div class="ann-form-grid">

            <div class="ann-form-group">
                <label>Category</label>

                <select name="announcement[category]">
                    <% ["General", "Academic", "Events", "Clubs", "Hostel", "Placement", "Examinations"].forEach(c => { %>
                        <option value="<%= c %>" <%= announcement.category === c ? "selected" : "" %>>
                            <%= c %>
                        </option>
                    <% }) %>
                </select>
            </div>


            <div class="ann-form-group">
                <label>Priority</label>

                <select name="announcement[priority]">
                    <% ["Normal", "Important", "Urgent"].forEach(p => { %>
                        <option value="<%= p %>" <%= announcement.priority === p ? "selected" : "" %>>
                            <%= p %>
                        </option>
                    <% }) %>
                </select>
            </div>

        </div>


        <div class="ann-scope-info">
            <i class="fa-solid fa-lock"></i>
            Publishing scope:
            <strong>
                <%= announcement.scope === "College"
                    ? "College"
                    : announcement.scope === "Class"
                    ? announcement.branch + " · Year " + announcement.year + " · " + announcement.section
                    : announcement.club %>
            </strong>
            <span>Cannot be changed.</span>
        </div>


        <% if (announcement.attachment) { %>
            <div class="ann-current-attachment">
                <label>Current attachment</label>

                <img src="<%= announcement.attachment %>" alt="Current attachment">
            </div>
        <% } %>


        <div class="ann-form-group">
            <label>Replace attachment (optional)</label>

            <label for="announcementAttachment" class="ann-upload-box">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <strong>Choose a new image</strong>
                <span>JPG, PNG or WEBP · Maximum 10 MB</span>

                <input
                    type="file"
                    id="announcementAttachment"
                    name="attachment"
                    accept="image/png,image/jpeg,image/webp"
                >
            </label>

            <div id="imagePreview" class="ann-image-preview"></div>
        </div>


        <div class="ann-form-actions">
            <a href="/announcements/<%= announcement._id %>" class="ann-btn ann-btn-light">
                Cancel
            </a>

            <button type="submit" class="ann-btn ann-btn-primary">
                Save Changes
            </button>
        </div>

    </form>

</div>

<script src="/js/announcements.js"></script>