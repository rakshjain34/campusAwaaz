<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Login to CampusAwaaz</h1>

    <div class="col-6 offset-3">
        <form action="/user/login" method="POST" class="needs-validation" novalidate>

            <div class="mb-3">
                <label for="username" class="form-label">College Email</label>
                <input
                    id="username"
                    name="username"
                    type="email"
                    placeholder="Enter your college email"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">Looks Good!</div>
                <div class="invalid-feedback">Enter your college email</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input
                    id="password"
                    name="password"
                    type="password"
                    placeholder="Enter your password"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">Looks Good!</div>
                <div class="invalid-feedback">Enter your password</div>
            </div>

            <button class="btn btn-success">Login</button>

        </form>

        <p class="mt-3">
            Don't have an account?
            <a href="/user/signup">Sign up here</a>
        </p>
    </div>
</div>