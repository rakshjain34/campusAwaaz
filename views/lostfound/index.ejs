<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/lostfound.css">

<main class="lf-page lf-list-page">
    <header class="lf-header">
        <div>
            <span class="lf-eyebrow">CAMPUSAWAAZ · CAMPUS LIFE</span>
            <h1><%= mine ? "My Reports" : "Lost & Found" %></h1>
            <p>Report lost items and help return found belongings.</p>
        </div>

        <div class="lf-actions">
            <% if (mine) { %>
                <a href="/lostfound" class="lf-button lf-button-light">All reports</a>
            <% } else { %>
                <a href="/lostfound/mine" class="lf-button lf-button-light">My reports</a>
            <% } %>
            <a href="/lostfound/new" class="lf-button">＋ Report an item</a>
        </div>
    </header>

    <% if (!mine) { %>
        <form action="/lostfound" method="GET" class="lf-filter-panel">
            <label class="lf-search-field">
                <span>Search</span>
                <input class="form-control" name="search" placeholder="Search item names or details..." value="<%= filters.search || '' %>">
            </label>
            <label>
                <span>Report type</span>
                <select class="form-select" name="itemType">
                    <option value="">Lost and found</option>
                    <option value="Lost" <%= filters.itemType === "Lost" ? "selected" : "" %>>Lost</option>
                    <option value="Found" <%= filters.itemType === "Found" ? "selected" : "" %>>Found</option>
                </select>
            </label>
            <label>
                <span>Category</span>
                <select class="form-select" name="category">
                    <option value="">All categories</option>
                    <% ["Electronics", "ID Card", "Books", "Clothing", "Accessories", "Other"].forEach(category => { %>
                        <option value="<%= category %>" <%= filters.category === category ? "selected" : "" %>><%= category %></option>
                    <% }) %>
                </select>
            </label>
            <button class="lf-button" type="submit">Filter reports</button>
        </form>
    <% } %>

    <section class="lf-section" aria-labelledby="lf-reports-heading">
        <div class="lf-section-heading">
            <div>
                <span class="lf-eyebrow"><%= mine ? "YOUR ACTIVITY" : "COMMUNITY BOARD" %></span>
                <h2 id="lf-reports-heading"><%= mine ? "Your reports" : "Recent reports" %></h2>
            </div>
            <span class="lf-count"><%= items.length %> <%= items.length === 1 ? "report" : "reports" %></span>
        </div>

        <% if (!items.length) { %>
            <div class="lf-empty-state">
                <div class="lf-empty-icon" aria-hidden="true">⌕</div>
                <h3>No reports found</h3>
                <p><%= mine ? "Your reports will appear here after you submit one." : "Try changing the filters or report an item to get started." %></p>
            </div>
        <% } else { %>
            <div class="lf-grid">
                <% items.forEach(item => { %>
                    <article class="lf-item-card">
                        <% if (item.image) { %>
                            <img src="<%= item.image %>" class="lf-item-image" alt="<%= item.name %>">
                        <% } else { %>
                            <div class="lf-item-image lf-image-placeholder" aria-hidden="true">⌕</div>
                        <% } %>

                        <div class="lf-card-body">
                            <div class="lf-card-tags">
                                <span class="lf-item-type"><%= item.itemType %></span>
                                <span class="lf-status-badge"><%= item.status %></span>
                            </div>
                            <h3><%= item.name %></h3>
                            <p class="lf-item-subtitle"><%= item.category %> · <%= item.color %></p>
                            <p class="lf-item-description"><%= item.description.length > 120 ? item.description.slice(0, 120) + "..." : item.description %></p>

                            <div class="lf-card-meta">
                                <span><i class="fa-solid fa-location-dot"></i> <%= item.location %></span>
                                <span><%= new Date(item.date).toLocaleDateString("en-IN", { day: "numeric", month: "short" }) %></span>
                            </div>
                            <a href="/lostfound/<%= item._id %>" class="lf-button lf-button-outline">View report <span aria-hidden="true">→</span></a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>
</main>
