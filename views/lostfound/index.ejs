
<% layout("/layouts/boilerplate") -%>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1><%= mine ? "My Reports" : "Lost & Found" %></h1>
            <p class="text-muted">Report lost items and help return found belongings.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/lostfound/new" class="btn btn-primary">Report an Item</a>
            <a href="/lostfound/mine" class="btn btn-outline-secondary">My Reports</a>
        </div>
    </div>

    <% if (!mine) { %>
        <form action="/lostfound" method="GET" class="card card-body mb-4">
            <div class="row g-2">
                <div class="col-md-5">
                    <input class="form-control" name="search" placeholder="Search items..." value="<%= filters.search || '' %>">
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="itemType">
                        <option value="">Lost and Found</option>
                        <option value="Lost" <%= filters.itemType === "Lost" ? "selected" : "" %>>Lost</option>
                        <option value="Found" <%= filters.itemType === "Found" ? "selected" : "" %>>Found</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" name="category">
                        <option value="">All Categories</option>
                        <% ["Electronics", "ID Card", "Books", "Clothing", "Accessories", "Other"].forEach(category => { %>
                            <option value="<%= category %>" <%= filters.category === category ? "selected" : "" %>><%= category %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary w-100" type="submit">Go</button>
                </div>
            </div>
        </form>
    <% } %>

    <% if (!items.length) { %>
        <div class="card card-body text-center py-5">
            <h4>No reports found</h4>
            <p class="text-muted mb-0">There are no items to display right now.</p>
        </div>
    <% } %>

    <div class="row g-4">
        <% items.forEach(item => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <% if (item.image) { %>
                        <img src="<%= item.image %>" class="card-img-top" alt="Item image" style="height:220px; object-fit:cover;">
                    <% } %>

                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2 mb-2">
                            <span class="badge <%= item.itemType === 'Lost' ? 'bg-danger' : 'bg-success' %>"><%= item.itemType %></span>
                            <span class="badge bg-secondary"><%= item.status %></span>
                        </div>

                        <h5 class="card-title"><%= item.name %></h5>
                        <p class="text-muted mb-2"><%= item.category %> · <%= item.color %></p>
                        <p><%= item.description.length > 120 ? item.description.slice(0, 120) + "..." : item.description %></p>
                        <p class="mb-1"><i class="fa-solid fa-location-dot"></i> <%= item.location %></p>
                        <p class="text-muted small">Date: <%= new Date(item.date).toLocaleDateString("en-IN") %></p>
                        <a href="/lostfound/<%= item._id %>" class="btn btn-outline-primary">View Details</a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>
