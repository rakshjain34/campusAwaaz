
<% layout("/layouts/boilerplate") -%>

<div class="container py-4 lostfound-page">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 lostfound-header">
        <div>
            <span class="lf-subtitle">CAMPUS SERVICES</span>
            <h1><%= mine ? "My Reports" : "Lost & Found" %></h1>
            <p class="text-muted mb-0">Report lost items and help return found belongings.</p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a href="/lostfound/new" class="btn lf-report-btn">
                <i class="fa-solid fa-plus me-2"></i>Report an Item
            </a>
            <a href="/lostfound/mine" class="btn lf-myreports-btn">
                <i class="fa-solid fa-folder-open me-2"></i>My Reports
            </a>
        </div>
    </div>

    <% if (!mine) { %>
        <form action="/lostfound" method="GET" class="lf-filter-card mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="lf-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input class="form-control" name="search" placeholder="Search items..." value="<%= filters.search || '' %>">
                    </div>
                </div>

                <div class="col-md-3">
                    <select class="form-select" name="itemType">
                        <option value="">Lost and Found</option>
                        <option value="Lost" <%= filters.itemType === "Lost" ? "selected" : "" %>>Lost</option>
                        <option value="Found" <%= filters.itemType === "Found" ? "selected" : "" %>>Found</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select class="form-select" name="category">
                        <option value="">All Categories</option>
                        <% ["Electronics", "ID Card", "Books", "Clothing", "Accessories", "Other"].forEach(category => { %>
                            <option value="<%= category %>" <%= filters.category === category ? "selected" : "" %>><%= category %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="col-md-1">
                    <button class="btn lf-search-btn w-100" type="submit">Go</button>
                </div>
            </div>
        </form>
    <% } %>

    <% if (!items.length) { %>
        <div class="lf-empty-state">
            <div class="lf-empty-icon">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <h4>No reports found</h4>
            <p>There are no items to display right now.</p>
        </div>
    <% } %>

    <div class="row g-4">
        <% items.forEach(item => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card lf-report-card h-100">

                    <% if (item.image) { %>
                        <img src="<%= item.image %>" class="card-img-top lf-item-image" alt="Item image">
                    <% } else { %>
                        <div class="lf-no-image">
                            <i class="fa-regular fa-image"></i>
                            <span>No image available</span>
                        </div>
                    <% } %>

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <span class="badge <%= item.itemType === 'Lost' ? 'bg-danger' : 'bg-success' %>"><%= item.itemType %></span>
                            <span class="badge bg-secondary"><%= item.status %></span>
                        </div>

                        <h5 class="card-title"><%= item.name %></h5>

                        <p class="lf-category mb-2">
                            <i class="fa-solid fa-tag me-1"></i>
                            <%= item.category %> · <%= item.color %>
                        </p>

                        <p class="lf-description">
                            <%= item.description.length > 120 ? item.description.slice(0, 120) + "..." : item.description %>
                        </p>

                        <div class="lf-item-info">
                            <p>
                                <i class="fa-solid fa-location-dot"></i>
                                <%= item.location %>
                            </p>
                            <p>
                                <i class="fa-regular fa-calendar"></i>
                                <%= new Date(item.date).toLocaleDateString("en-IN") %>
                            </p>
                        </div>

                        <a href="/lostfound/<%= item._id %>" class="btn lf-view-btn mt-auto">
                            View Details <i class="fa-solid fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

</div>
