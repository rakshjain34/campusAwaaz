
<% layout("/layouts/boilerplate") -%>

<div class="container py-4" style="max-width: 800px;">
    <a href="/lostfound" class="text-decoration-none">← Back to Lost & Found</a>
    <h1 class="mt-3">Report an Item</h1>
    <p class="text-muted">Enter the details so other students can help.</p>

    <form action="/lostfound" method="POST" enctype="multipart/form-data" class="card card-body gap-3">
        <div>
            <label class="form-label">Item Name</label>
            <input class="form-control" name="lostfound[name]" maxlength="100" required>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Report Type</label>
                <select class="form-select" name="lostfound[itemType]" required>
                    <option value="">Choose type</option>
                    <option value="Lost">I lost this item</option>
                    <option value="Found">I found this item</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Category</label>
                <select class="form-select" name="lostfound[category]" required>
                    <option value="">Choose category</option>
                    <% ["Electronics", "ID Card", "Books", "Clothing", "Accessories", "Other"].forEach(category => { %>
                        <option value="<%= category %>"><%= category %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Color</label>
                <input class="form-control" name="lostfound[color]" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Location</label>
                <input class="form-control" name="lostfound[location]" placeholder="Where was it lost or found?" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Date</label>
                <input class="form-control" type="date" name="lostfound[date]" max="<%= new Date().toISOString().slice(0, 10) %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Item Image (optional)</label>
                <input class="form-control" type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
                <small class="text-muted">Maximum size: 5 MB</small>
            </div>
        </div>

        <div>
            <label class="form-label">Description</label>
            <textarea class="form-control" name="lostfound[description]" rows="4" maxlength="2000" required></textarea>
        </div>

        <div>
            <label class="form-label">Identifying Details (optional)</label>
            <textarea class="form-control" name="lostfound[specifications]" rows="2" maxlength="1000" placeholder="Brand, model, marks or other details"></textarea>
        </div>

        <button class="btn btn-primary" type="submit">Submit Report</button>
    </form>
</div>
