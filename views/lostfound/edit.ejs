
<% layout("/layouts/boilerplate") -%>

<div class="container py-4" style="max-width: 800px;">
    <a href="/lostfound/<%= item._id %>" class="text-decoration-none">← Back to report</a>
    <h1 class="mt-3">Edit Report</h1>

    <form action="/lostfound/<%= item._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="card card-body gap-3">
        <div>
            <label class="form-label">Item Name</label>
            <input class="form-control" name="lostfound[name]" value="<%= item.name %>" maxlength="100" required>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Report Type</label>
                <select class="form-select" name="lostfound[itemType]" required>
                    <option value="Lost" <%= item.itemType === "Lost" ? "selected" : "" %>>Lost</option>
                    <option value="Found" <%= item.itemType === "Found" ? "selected" : "" %>>Found</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Category</label>
                <select class="form-select" name="lostfound[category]" required>
                    <% ["Electronics", "ID Card", "Books", "Clothing", "Accessories", "Other"].forEach(category => { %>
                        <option value="<%= category %>" <%= item.category === category ? "selected" : "" %>><%= category %></option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Color</label>
                <input class="form-control" name="lostfound[color]" value="<%= item.color %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Location</label>
                <input class="form-control" name="lostfound[location]" value="<%= item.location %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Date</label>
                <input class="form-control" type="date" name="lostfound[date]" value="<%= new Date(item.date).toISOString().slice(0, 10) %>" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Status</label>
                <select class="form-select" name="lostfound[status]" required>
                    <option value="Active" <%= item.status === "Active" ? "selected" : "" %>>Active</option>
                    <option value="Resolved" <%= item.status === "Resolved" ? "selected" : "" %>>Resolved</option>
                </select>
            </div>
        </div>

        <div>
            <label class="form-label">Description</label>
            <textarea class="form-control" name="lostfound[description]" rows="4" maxlength="2000" required><%= item.description %></textarea>
        </div>

        <div>
            <label class="form-label">Identifying Details</label>
            <textarea class="form-control" name="lostfound[specifications]" rows="2" maxlength="1000"><%= item.specifications || "" %></textarea>
        </div>

        <% if (item.image) { %>
            <div>
                <p class="form-label">Current Image</p>
                <img src="<%= item.image %>" alt="Current item image" style="max-width:220px; max-height:180px; object-fit:cover;">
            </div>
        <% } %>

        <div>
            <label class="form-label">Replace Image (optional)</label>
            <input class="form-control" type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
            <small class="text-muted">Maximum size: 5 MB</small>
        </div>

        <button class="btn btn-primary" type="submit">Save Changes</button>
    </form>
</div>
