<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/lostfound.css">

<main class="lf-page lf-detail-page">
    <a href="/lostfound" class="text-decoration-none lf-back">← Back to Lost & Found</a>

    <div class="lf-detail-grid">
        <div class="lf-detail-image-column">
            <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.name %>" class="lf-detail-image">
            <% } else { %>
                <div class="lf-detail-placeholder">
                    <span class="text-muted">No image provided</span>
                </div>
            <% } %>
        </div>

        <article class="lf-detail-panel">
            <div class="d-flex gap-2 mb-3">
                <span class="badge lf-item-type"><%= item.itemType %></span>
                <span class="badge lf-status-badge"><%= item.status %></span>
            </div>

            <h1><%= item.name %></h1>
            <p class="text-muted"><%= item.category %> · <%= item.color %></p>
            <p><%= item.description %></p>

            <div class="lf-detail-meta">
                <p><strong>Location:</strong> <%= item.location %></p>
                <p><strong>Date:</strong> <%= new Date(item.date).toLocaleDateString("en-IN") %></p>
                <p><strong>Reported by:</strong> <%= item.createdBy?.name || "Campus user" %></p>
                <% if (item.createdBy?.branch) { %>
                    <p><strong>Branch:</strong> <%= item.createdBy.branch %></p>
                <% } %>
                <% if (item.specifications) { %>
                    <p><strong>Identifying details:</strong> <%= item.specifications %></p>
                <% } %>
            </div>

            <% if (currUser && item.createdBy?.email && item.createdBy._id.toString() !== currUser._id.toString()) { %>
                <a href="mailto:<%= item.createdBy.email %>?subject=Regarding%20your%20Lost%20and%20Found%20report" class="btn btn-primary lf-button mt-2">
                    <i class="fa-solid fa-envelope"></i> Contact Owner
                </a>
            <% } %>

            <% if (currUser && item.createdBy && item.createdBy._id.toString() === currUser._id.toString()) { %>
                <div class="lf-detail-actions">
                    <a href="/lostfound/<%= item._id %>/edit" class="btn btn-outline-primary lf-button lf-button-outline">Edit</a>

                    <% if (item.status === "Active") { %>
                        <form action="/lostfound/<%= item._id %>/resolve" method="POST">
                        <button class="btn lf-button" type="submit">Mark Resolved</button>
                        </form>
                    <% } %>

                    <form action="/lostfound/<%= item._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this report?')">
                        <button class="btn btn-danger" type="submit">Delete</button>
                    </form>
                </div>
            <% } %>
        </article>
    </div>

    <% if (matches.length) { %>
        <section class="lf-related-section">
        <div class="lf-section-heading">
            <div>
                <span class="lf-eyebrow">POSSIBLE MATCHES</span>
                <h2>Related reports</h2>
            </div>
            <span class="lf-count"><%= matches.length %> <%= matches.length === 1 ? "match" : "matches" %></span>
        </div>
        <p class="lf-section-copy">These reports have the opposite type and the same category.</p>

        <div class="lf-grid lf-related-grid">
            <% matches.forEach(match => { %>
                    <article class="lf-related-card">
                        <% if (match.image) { %>
                            <img src="<%= match.image %>" class="lf-related-image" alt="<%= match.name %>">
                        <% } else { %>
                            <div class="lf-related-image-placeholder" aria-hidden="true">⌕</div>
                        <% } %>
                        <div class="card-body">
                            <span class="lf-item-type"><%= match.itemType %></span>
                            <h3 class="mt-2"><%= match.name %></h3>
                            <p class="text-muted"><%= match.category %> · <%= match.color %></p>
                            <div class="lf-related-actions">
                            <a href="/lostfound/<%= match._id %>" class="btn btn-outline-primary lf-button lf-button-outline">View Report</a>

                            <% if (currUser && match.createdBy?.email && match.createdBy._id.toString() !== currUser._id.toString()) { %>
                                <a href="mailto:<%= match.createdBy.email %>?subject=Regarding%20your%20Lost%20and%20Found%20report" class="btn btn-primary lf-button mt-2">
                                    <i class="fa-solid fa-envelope"></i> Contact Owner
                                </a>
                            <% } %>
                            </div>
                        </div>
                    </article>
            <% }) %>
        </div>
        </section>
    <% } %>
</main>
