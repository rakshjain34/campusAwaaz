<% layout("/layouts/boilerplate") -%>

<main class="container py-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <span class="text-uppercase small fw-bold text-success">CampusAwaaz</span>
            <h1 class="h2 mb-1">Notifications</h1>
            <p class="text-muted mb-0">
                <%= unreadCount %> unread <%= unreadCount === 1 ? 'notification' : 'notifications' %>
            </p>
        </div>
        <% if (unreadCount) { %>
            <form action="/notifications/read-all" method="POST">
                <button class="btn btn-outline-success">Mark all as read</button>
            </form>
        <% } %>
    </div>

    <% if (!notifications.length) { %>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center">
                <i class="fa-regular fa-bell-slash fs-2 text-muted"></i>
                <h2 class="h5 mt-3">No notifications yet</h2>
                <p class="text-muted mb-0">Club announcements and other updates for you will appear here.</p>
            </div>
        </div>
    <% } else { %>
        <div class="d-grid gap-3">
            <% notifications.forEach(notification => { %>
                <article class="card border-0 shadow-sm rounded-4 <%= notification.isRead ? '' : 'border-start border-4 border-success' %>">
                    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="badge <%= notification.notificationType === 'Announcement' ? 'text-bg-primary' : 'text-bg-warning' %>">
                                    <%= notification.notificationType === 'Announcement' ? 'Club announcement' : 'Complaint update' %>
                                </span>
                                <% if (!notification.isRead) { %><span class="badge text-bg-success">New</span><% } %>
                            </div>

                            <% if (notification.announcement) { %>
                                <h2 class="h5 mb-1"><%= notification.announcement.title %></h2>
                                <p class="text-muted mb-1"><%= notification.announcement.club %></p>
                            <% } else if (notification.complaint) { %>
                                <h2 class="h5 mb-1"><%= notification.complaint.title %></h2>
                            <% } %>

                            <p class="mb-1"><%= notification.message %></p>
                            <small class="text-muted"><%= new Date(notification.createdAt).toLocaleString('en-IN') %></small>
                        </div>

                        <a class="btn btn-outline-success" href="/notifications/<%= notification._id %>/open">
                            Open
                        </a>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</main>
