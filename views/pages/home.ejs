<% layout("/layouts/boilerplate") %>

<div class="campus-dashboard">

    <main class="main-content">

        <div class="dashboard-content">

            <div class="dashboard-grid">

                <!-- ================= FEED SECTION ================= -->

                <section class="feed-section">


                    <!-- WELCOME -->

                    <div class="welcome-section">

                        <span class="welcome-label">

                            YOUR CAMPUS, YOUR COMMUNITY

                        </span>

                        <h1>

                            Your campus, in the loop.

                        </h1>

                        <p>

                            The updates, conversations, and help you need!
                            All in one place.

                        </p>

                    </div>



                    <!-- SEARCH -->

                    <form
                        action="/search"
                        method="GET"
                        class="search-bar"
                    >

                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input
                            type="text"
                            name="q"
                            placeholder="Search announcements, complaints, lost items..."
                            required
                        >

                        <button
                            type="submit"
                            aria-label="Search"
                        >

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>

                    </form>



                    <!-- QUICK ACCESS -->

                    <div class="quick-access">


                        <a
                            href="/announcements"
                            class="quick-card"
                        >

                            <div class="quick-icon mint">

                                <i class="fa-solid fa-bullhorn"></i>

                            </div>

                            <h6>Announcements</h6>

                            <p>Latest notices & events</p>

                            <i class="fa-solid fa-chevron-right card-arrow"></i>

                        </a>



                        <a
                            href="/complaints"
                            class="quick-card"
                        >

                            <div class="quick-icon peach">

                                <i class="fa-regular fa-clipboard"></i>

                            </div>

                            <h6>Report an issue</h6>

                            <p>Submit a complaint</p>

                            <i class="fa-solid fa-chevron-right card-arrow"></i>

                        </a>



                        <a
                            href="/lostfound"
                            class="quick-card"
                        >

                            <div class="quick-icon lavender">

                                <i class="fa-solid fa-magnifying-glass"></i>

                            </div>

                            <h6>Lost & Found</h6>

                            <p>Find or report lost items</p>

                            <i class="fa-solid fa-chevron-right card-arrow"></i>

                        </a>



                        <a
                            href="/services"
                            class="quick-card"
                        >

                            <div class="quick-icon blue">

                                <i class="fa-regular fa-calendar-days"></i>

                            </div>

                            <h6>Campus Services</h6>

                            <p>EV, shops and more</p>

                            <i class="fa-solid fa-chevron-right card-arrow"></i>

                        </a>


                    </div>



                    <!-- ================= FEED ================= -->

                    <% if (currentUser) { %>


                    <div class="feed-container">


                        <!-- FEED HEADER -->

                        <div class="feed-header">

                            <div class="feed-tabs">


                                <button
                                    class="feed-tab active"
                                    type="button"
                                    data-filter="all"
                                >

                                    For You

                                </button>



                                <button
                                    class="feed-tab"
                                    type="button"
                                    data-filter="trending"
                                >

                                    Trending

                                </button>



                                <button
                                    class="feed-tab"
                                    type="button"
                                    data-filter="campus"
                                >

                                    Campus Life

                                </button>


                            </div>



                            <select
                                class="sort-select"
                                id="feedSort"
                                aria-label="Sort posts"
                            >

                                <option value="latest">

                                    Latest

                                </option>

                                <option value="oldest">

                                    Oldest

                                </option>

                            </select>

                        </div>



                        <!-- FEED POSTS -->

                        <div id="feedPosts">


                            <!-- ================= ANNOUNCEMENTS ================= -->

                            <% announcements.forEach(post => { %>


                            <article

                                class="post-card"

                                data-type="announcement"

                                data-category="<%= post.category %>"

                                data-priority="<%= post.priority %>"

                                data-pinned="<%= post.isPinned %>"

                                data-date="<%= post.createdAt.getTime() %>"

                                data-upvotes="0"

                            >


                                <div class="post-heading">


                                    <div class="post-icon mint">

                                        <i class="fa-solid fa-bullhorn"></i>

                                    </div>



                                    <div class="post-author">


                                        <span class="category-badge mint">

                                            <%= post.category %>

                                        </span>



                                        <h5>

                                            <%= post.title %>

                                        </h5>



                                        <p>

                                            <i class="fa-solid fa-user"></i>

                                            <%= post.postedBy?.name || "Campus Publisher" %>

                                        </p>


                                    </div>



                                    <span class="post-time">

                                        <%= post.createdAt.toLocaleDateString(

                                            "en-IN",

                                            {

                                                day: "numeric",

                                                month: "short"

                                            }

                                        ) %>

                                    </span>


                                </div>



                                <p class="post-description">

                                    <%= post.description %>

                                </p>



                                <% if (post.priority === "Urgent") { %>


                                    <span class="category-badge peach">

                                        <i class="fa-solid fa-circle-exclamation"></i>

                                        Urgent

                                    </span>


                                <% } else if (post.priority === "Important") { %>


                                    <span class="category-badge lavender">

                                        Important

                                    </span>


                                <% } %>



                                <% if (post.attachment) { %>


                                    <div class="post-attachment">


                                        <a

                                            href="<%= post.attachment %>"

                                            target="_blank"

                                            rel="noopener noreferrer"

                                        >

                                            <i class="fa-solid fa-paperclip"></i>

                                            View attachment

                                        </a>


                                    </div>


                                <% } %>



                                <div class="post-actions">


                                    <a href="/announcements">

                                        <i class="fa-regular fa-eye"></i>

                                        View announcements

                                    </a>


                                </div>


                            </article>


                            <% }) %>



                            <!-- ================= COMPLAINTS ================= -->

                            <% complaints.forEach(post => { %>


                            <article

                                class="post-card"

                                data-type="complaint"

                                data-category="Complaint"

                                data-priority="<%= post.urgency %>"

                                data-pinned="false"

                                data-date="<%= post.createdAt.getTime() %>"

                                data-upvotes="<%= post.upvotes.length %>"

                            >


                                <div class="post-heading">


                                    <div class="post-icon peach">

                                        <i class="fa-solid fa-triangle-exclamation"></i>

                                    </div>



                                    <div class="post-author">


                                        <span class="category-badge peach">

                                            <%= post.category %>

                                        </span>



                                        <h5>

                                            <%= post.title %>

                                        </h5>



                                        <p>

                                            <i class="fa-solid fa-user-graduate"></i>

                                            <%= post.createdBy?.name || "Student" %>

                                        </p>


                                    </div>



                                    <span class="post-time">

                                        <%= post.createdAt.toLocaleDateString(

                                            "en-IN",

                                            {

                                                day: "numeric",

                                                month: "short"

                                            }

                                        ) %>

                                    </span>


                                </div>



                                <p class="post-description">

                                    <%= post.description %>

                                </p>



                                <div class="post-meta">


                                    <span>

                                        <i class="fa-solid fa-location-dot"></i>

                                        <%= post.category %>

                                    </span>



                                    <span>

                                        <%= post.subcategory %>

                                    </span>



                                    <span>

                                        Status: <%= post.status %>

                                    </span>


                                </div>



                                <div class="post-actions">


                                    <span>

                                        <i class="fa-solid fa-arrow-up"></i>

                                        <%= post.upvotes.length %> Upvotes

                                    </span>



                                    <a href="/complaints">

                                        <i class="fa-regular fa-eye"></i>

                                        View complaints

                                    </a>


                                </div>


                            </article>


                            <% }) %>



                            <!-- ================= LOST AND FOUND ================= -->

                            <% lostFound.forEach(post => { %>


                            <article

                                class="post-card"

                                data-type="lostfound"

                                data-category="<%= post.category %>"

                                data-priority="Normal"

                                data-pinned="false"

                                data-date="<%= post.createdAt.getTime() %>"

                                data-upvotes="0"

                            >


                                <div class="post-heading">


                                    <div class="post-icon lavender">

                                        <i class="fa-solid fa-magnifying-glass"></i>

                                    </div>



                                    <div class="post-author">


                                        <span class="category-badge lavender">

                                            <%= post.itemType %> · <%= post.category %>

                                        </span>



                                        <h5>

                                            <%= post.name %>

                                        </h5>



                                        <p>

                                            <i class="fa-solid fa-user-graduate"></i>

                                            <%= post.createdBy?.name || "Student" %>

                                        </p>


                                    </div>



                                    <span class="post-time">

                                        <%= post.createdAt.toLocaleDateString(

                                            "en-IN",

                                            {

                                                day: "numeric",

                                                month: "short"

                                            }

                                        ) %>

                                    </span>


                                </div>



                                <p class="post-description">

                                    <%= post.description %>

                                </p>



                                <div class="post-meta">


                                    <span>

                                        <i class="fa-solid fa-palette"></i>

                                        <%= post.color %>

                                    </span>



                                    <span>

                                        <i class="fa-solid fa-location-dot"></i>

                                        <%= post.location %>

                                    </span>



                                    <span>

                                        <%= new Date(post.date).toLocaleDateString(

                                            "en-IN",

                                            {

                                                day: "numeric",

                                                month: "short"

                                            }

                                        ) %>

                                    </span>


                                </div>



                                <% if (post.image) { %>


                                    <div class="post-attachment">


                                        <img

                                            src="<%= post.image %>"

                                            alt="<%= post.name %>"

                                            style="max-width:100%;max-height:250px;object-fit:contain;"

                                        >


                                    </div>


                                <% } %>



                                <div class="post-actions">


                                    <a href="/lostfound">

                                        <i class="fa-regular fa-eye"></i>

                                        View Lost & Found

                                    </a>


                                </div>


                            </article>


                            <% }) %>



                            <!-- EMPTY STATE -->

                            <% if (

                                announcements.length === 0 &&

                                complaints.length === 0 &&

                                lostFound.length === 0

                            ) { %>


                                <div class="empty-feed">


                                    <i class="fa-regular fa-newspaper"></i>



                                    <h5>

                                        It's quiet around here!

                                    </h5>



                                    <p>

                                        No campus updates yet.
                                        Check back later for new posts.

                                    </p>


                                </div>


                            <% } %>


                        </div>



                        <!-- FILTER EMPTY STATE -->

                        <div

                            id="filterEmpty"

                            style="display:none;text-align:center;padding:30px;"

                        >

                            <i class="fa-regular fa-folder-open"></i>

                            <p>No posts found in this category.</p>

                        </div>


                    </div>


                    <% } else { %>


                    <!-- LOGGED OUT MESSAGE -->

                    <div class="empty-feed">


                        <i class="fa-solid fa-users"></i>



                        <h5>

                            Your campus community awaits!

                        </h5>



                        <p>

                            Log in to explore campus updates,
                            trending complaints, and announcements.

                        </p>



                        <a href="/user/login" class="btn btn-success">

                            Log in to CampusAwaaz

                        </a>


                    </div>


                    <% } %>


                </section>



                <!-- ================= RIGHT SIDEBAR ================= -->

                <aside class="right-sidebar">



                    <!-- ================= CAMPUS EVENTS ================= -->

                    <section class="widget-card">


                        <div class="widget-heading">


                            <h5>

                                Campus events

                            </h5>



                            <a href="/announcements">

                                View all

                            </a>


                        </div>



                        <% if (eventAnnouncements.length > 0) { %>



                            <% eventAnnouncements.forEach(event => { %>



                                <div class="event-card">


                                    <div class="event-date">


                                        <span>

                                            <%= event.createdAt.toLocaleDateString(

                                                "en-IN",

                                                {

                                                    month: "short"

                                                }

                                            ).toUpperCase() %>

                                        </span>



                                        <strong>

                                            <%= event.createdAt.getDate() %>

                                        </strong>


                                    </div>



                                    <div class="event-info">


                                        <h6>

                                            <%= event.title %>

                                        </h6>



                                        <p>

                                            <i class="fa-solid fa-calendar"></i>

                                            Posted <%= event.createdAt.toLocaleDateString(

                                                "en-IN",

                                                {

                                                    day: "numeric",

                                                    month: "short"

                                                }

                                            ) %>

                                        </p>



                                        <p>

                                            <%= event.description.length > 100

                                                ? event.description.substring(0, 100) + "..."

                                                : event.description %>

                                        </p>


                                    </div>


                                </div>



                            <% }) %>



                        <% } else { %>



                            <div class="empty-widget">


                                <i class="fa-regular fa-calendar"></i>



                                <p>

                                    No event announcements yet.

                                </p>


                            </div>



                        <% } %>


                    </section>



                    <!-- ================= CAMPUS PULSE ================= -->

                    <section class="widget-card">



                        <div class="widget-heading pulse-heading">


                            <div class="pulse-icon">

                                <i class="fa-solid fa-wave-square"></i>

                            </div>



                            <div>


                                <h5>

                                    Campus pulse

                                </h5>



                                <p>

                                    What's happening around you

                                </p>


                            </div>


                        </div>



                        <!-- OPEN COMPLAINTS -->

                        <a href="/complaints" class="pulse-item">


                            <div class="pulse-item-icon peach">

                                <i class="fa-solid fa-circle-exclamation"></i>

                            </div>



                            <div>


                                <h4>

                                    <%= pulse.openComplaints %>

                                </h4>



                                <p>

                                    Open complaints

                                </p>


                            </div>



                            <i class="fa-solid fa-chevron-right"></i>


                        </a>



                        <!-- REUNITED ITEMS -->

                        <a href="/lostfound" class="pulse-item">


                            <div class="pulse-item-icon lavender">

                                <i class="fa-solid fa-check"></i>

                            </div>



                            <div>


                                <h4>

                                    <%= pulse.reunitedItems %>

                                </h4>



                                <p>

                                    Items reunited

                                </p>


                            </div>



                            <i class="fa-solid fa-chevron-right"></i>


                        </a>



                        <!-- NEW NOTICES -->

                        <a href="/announcements" class="pulse-item">


                            <div class="pulse-item-icon mint">

                                <i class="fa-solid fa-bullhorn"></i>

                            </div>



                            <div>


                                <h4>

                                    <%= pulse.newNotices %>

                                </h4>



                                <p>

                                    New notices this week

                                </p>


                            </div>



                            <i class="fa-solid fa-chevron-right"></i>


                        </a>



                        <!-- COMMUNITY CTA -->

                        <a

                            href="/complaints/new"

                            class="community-cta"

                        >


                            <div class="community-icon">

                                <i class="fa-solid fa-users"></i>

                            </div>



                            <div>


                                <h6>

                                    Something on your mind?

                                </h6>



                                <p>

                                    Make your voice heard.

                                </p>


                            </div>



                            <i class="fa-solid fa-chevron-right"></i>


                        </a>


                    </section>


                </aside>


            </div>

        </div>

    </main>

</div>



<!-- ================= FEED FUNCTIONALITY ================= -->

<% if (currentUser) { %>


<script>

document.addEventListener("DOMContentLoaded", () => {


    const tabs = document.querySelectorAll(".feed-tab");

    const sortSelect = document.getElementById("feedSort");

    const feed = document.getElementById("feedPosts");

    const emptyMessage = document.getElementById("filterEmpty");


    const originalPosts = Array.from(

        feed.querySelectorAll(".post-card")

    );


    let currentFilter = "all";



    function updateFeed() {


        let visiblePosts = [...originalPosts];



        // =========================================
        // TRENDING
        // Only complaints with 5+ upvotes
        // =========================================

        if (currentFilter === "trending") {


            visiblePosts = visiblePosts.filter(post => {


                const upvotes = Number(

                    post.dataset.upvotes

                );


                return (

                    post.dataset.type === "complaint" &&

                    upvotes >= 5

                );


            });


        }



        // =========================================
        // CAMPUS LIFE
        // All announcements
        // =========================================

        if (currentFilter === "campus") {


            visiblePosts = visiblePosts.filter(post => {


                return (

                    post.dataset.type === "announcement"

                );


            });


        }



        // =========================================
        // SORT
        // =========================================

        const sortOrder = sortSelect.value;


        visiblePosts.sort((a, b) => {


            const dateA = Number(

                a.dataset.date

            );


            const dateB = Number(

                b.dataset.date

            );


            if (sortOrder === "oldest") {


                return dateA - dateB;


            }


            return dateB - dateA;


        });



        // =========================================
        // PINNED ANNOUNCEMENTS FIRST
        // =========================================

        if (

            sortOrder === "latest" &&

            currentFilter === "all"

        ) {


            visiblePosts.sort((a, b) => {


                const pinnedA =

                    a.dataset.pinned === "true" ? 1 : 0;


                const pinnedB =

                    b.dataset.pinned === "true" ? 1 : 0;



                if (pinnedA !== pinnedB) {


                    return pinnedB - pinnedA;


                }



                return (

                    Number(b.dataset.date) -

                    Number(a.dataset.date)

                );


            });


        }



        // =========================================
        // HIDE ALL POSTS
        // =========================================

        originalPosts.forEach(post => {


            post.style.display = "none";


        });



        // =========================================
        // DISPLAY FILTERED POSTS
        // =========================================

        visiblePosts.forEach(post => {


            post.style.display = "";


            feed.appendChild(post);


        });



        // =========================================
        // EMPTY STATE
        // =========================================

        emptyMessage.style.display =

            visiblePosts.length === 0

                ? "block"

                : "none";


    }



    // =========================================
    // TAB CLICK
    // =========================================

    tabs.forEach(tab => {


        tab.addEventListener("click", () => {


            tabs.forEach(t => {


                t.classList.remove("active");


            });



            tab.classList.add("active");



            currentFilter = tab.dataset.filter;



            updateFeed();


        });


    });



    // =========================================
    // SORT CHANGE
    // =========================================

    sortSelect.addEventListener(

        "change",

        updateFeed

    );



    // INITIAL FEED
    updateFeed();


});

</script>


<% } %>