<% layout("/layouts/boilerplate") -%>
<div class="container mt-5 text-center">
    <h1>Welcome to CampusAwaaz!</h1>
    <p class="lead">
        Your campus, your voice.
    </p>
    <% if (!currUser) { %>
        <a href="/user/signup" class="btn btn-success">Sign Up</a>
        <a href="/user/login" class="btn btn-outline-success">Login</a>
    <% } else { %>
        <h4>Welcome, <%= currUser.name %>!</h4>
    <% } %>
</div>