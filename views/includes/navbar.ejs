<nav class="navbar campus-navbar">
    <div class="container-fluid px-4">
        <a class="navbar-brand campus-brand" href="/">
            Campus<span>Awaaz</span>
        </a>

        <div class="d-flex align-items-center gap-3 ms-auto">
            <% if (typeof currUser !== "undefined" && currUser) { %>
                <a href="/notifications" class="notification-link" aria-label="Notifications">
                    <i class="fa-regular fa-bell"></i>
                </a>

                <a href="/user/profile" class="navbar-profile-link">
                    <div class="navbar-avatar">
                        <i class="fa-regular fa-user"></i>
                    </div>
                    <span class="navbar-user-name"><%= currUser.name || currUser.firstName || "Student" %></span>
                </a>

                <form action="/user/logout" method="POST" class="m-0">
                    <button type="submit" class="btn btn-sm logout-btn">Logout</button>
                </form>
            <% } else { %>
                <a href="/user/login" class="btn btn-outline-success btn-sm">Login</a>
                <a href="/user/signup" class="btn btn-success btn-sm">Sign Up</a>
            <% } %>
        </div>
    </div>
</nav>